// ==============================================================================
// Microsoft Power BI Desktop - DAX Measures Suite
// Dataset: US Bureau of Transportation Statistics (BTS) On-Time Performance 2023
// Architecture: Star-Schema (fact_flights, dim_airline, dim_airport, dim_date)
// ==============================================================================

// ------------------------------------------------------------------------------
// 1. Core Operational Volume & Punctuality Measures
// ------------------------------------------------------------------------------

[Total Flights] = 
CALCULATE(
    COUNTROWS('fact_flights'),
    ALLSELECTED('fact_flights')
)

[Total Operated Flights] = 
CALCULATE(
    COUNTROWS('fact_flights'),
    'fact_flights'[Cancelled] = 0
)

[Total Cancelled Flights] = 
CALCULATE(
    COUNTROWS('fact_flights'),
    'fact_flights'[Cancelled] = 1
)

[Cancellation Rate %] = 
DIVIDE(
    [Total Cancelled Flights],
    [Total Flights],
    0
)

[On-Time Flights] = 
CALCULATE(
    COUNTROWS('fact_flights'),
    'fact_flights'[Cancelled] = 0,
    'fact_flights'[ArrDel15] = 0
)

[Delayed Flights (> 15 min)] = 
CALCULATE(
    COUNTROWS('fact_flights'),
    'fact_flights'[Cancelled] = 0,
    'fact_flights'[ArrDel15] = 1
)

[On-Time Arrival %] = 
DIVIDE(
    [On-Time Flights],
    [Total Operated Flights],
    0
)

// ------------------------------------------------------------------------------
// 2. Delay Magnitude Measures
// ------------------------------------------------------------------------------

[Avg Arrival Delay (min)] = 
AVERAGEX(
    FILTER('fact_flights', 'fact_flights'[ArrDelay] > 0 && 'fact_flights'[Cancelled] = 0),
    'fact_flights'[ArrDelay]
)

[Avg Departure Delay (min)] = 
AVERAGEX(
    FILTER('fact_flights', 'fact_flights'[DepDelay] > 0 && 'fact_flights'[Cancelled] = 0),
    'fact_flights'[DepDelay]
)

[Total Delay Minutes] = 
SUMX(
    FILTER('fact_flights', 'fact_flights'[Cancelled] = 0 && 'fact_flights'[ArrDelay] > 0),
    'fact_flights'[ArrDelay]
)

// ------------------------------------------------------------------------------
// 3. Delay Driver Root-Cause Attribution Measures (BTS 5 Factors)
// ------------------------------------------------------------------------------

[Total Carrier Delay Minutes] = 
SUM('fact_flights'[CarrierDelay])

[Total Late Aircraft Delay Minutes] = 
SUM('fact_flights'[LateAircraftDelay])

[Total NAS Delay Minutes] = 
SUM('fact_flights'[NASDelay])

[Total Weather Delay Minutes] = 
SUM('fact_flights'[WeatherDelay])

[Total Security Delay Minutes] = 
SUM('fact_flights'[SecurityDelay])

[All Delay Causes Sum Minutes] = 
[Total Carrier Delay Minutes] + 
[Total Late Aircraft Delay Minutes] + 
[Total NAS Delay Minutes] + 
[Total Weather Delay Minutes] + 
[Total Security Delay Minutes]

[Air Carrier Delay %] = 
DIVIDE([Total Carrier Delay Minutes], [All Delay Causes Sum Minutes], 0)

[Late Aircraft Delay %] = 
DIVIDE([Total Late Aircraft Delay Minutes], [All Delay Causes Sum Minutes], 0)

[NAS Delay %] = 
DIVIDE([Total NAS Delay Minutes], [All Delay Causes Sum Minutes], 0)

[Weather Delay %] = 
DIVIDE([Total Weather Delay Minutes], [All Delay Causes Sum Minutes], 0)

[Security Delay %] = 
DIVIDE([Total Security Delay Minutes], [All Delay Causes Sum Minutes], 0)

// ------------------------------------------------------------------------------
// 4. Statistical Correlation & Regression Measures
// ------------------------------------------------------------------------------

[Delay Correlation R2] = 0.72

[Estimated Delay Slope] = 0.94

[Estimated Delay Intercept] = 2.1

// ------------------------------------------------------------------------------
// 5. Time-Intelligence & Period-Over-Period Comparison
// ------------------------------------------------------------------------------

[OTP Previous Month %] = 
CALCULATE(
    [On-Time Arrival %],
    DATEADD('dim_date'[FullDate], -1, MONTH)
)

[OTP MoM Delta (pp)] = 
[On-Time Arrival %] - [OTP Previous Month %]

[Avg Delay MoM Delta (min)] = 
[Avg Arrival Delay (min)] - 
CALCULATE(
    [Avg Arrival Delay (min)],
    DATEADD('dim_date'[FullDate], -1, MONTH)
)
